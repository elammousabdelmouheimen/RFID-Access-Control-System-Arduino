#include <SPI.h>
#include <MFRC522.h>
#include <Servo.h>

MFRC522 rfid(10, 9);
Servo door;

byte authorizedUID[] = {0xA3, 0xB2, 0xC1, 0xD4};

int greenLED = 4;
int redLED = 3;
int buzzer = 5;

void setup() {
    Serial.begin(9600);
    SPI.begin();
    rfid.PCD_Init();

    door.attach(6);
    door.write(0);

    pinMode(greenLED, OUTPUT);
    pinMode(redLED, OUTPUT);
    pinMode(buzzer, OUTPUT);
}

void loop() {
    if (!rfid.PICC_IsNewCardPresent())
        return;

    if (!rfid.PICC_ReadCardSerial())
        return;

    bool authorized = (rfid.uid.size == 4);

    for (int i = 0; i < 4; i++) {
        if (rfid.uid.uidByte[i] != authorizedUID[i])
            authorized = false;
    }

    if (authorized) {
        Serial.println("Access granted");

        digitalWrite(greenLED, HIGH);
        door.write(90);

        delay(5000);

        door.write(0);
        digitalWrite(greenLED, LOW);
    }
    else {
        Serial.println("Access denied");

        digitalWrite(redLED, HIGH);
        tone(buzzer, 500);

        delay(1000);

        noTone(buzzer);
        digitalWrite(redLED, LOW);
    }

    rfid.PICC_HaltA();
    rfid.PCD_StopCrypto1();
}

